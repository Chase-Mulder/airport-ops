<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core persistence for the desktop build. SQLite by default (zero install), SQL Server via appsettings.json. -->
  <PropertyGroup>
    <RootNamespace>Airport.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <!-- Pinned above the versions EF pulls in transitively, which have known vulnerabilities (NU1902/NU1903). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Airport.Core\Airport.Core.csproj" />
  </ItemGroup>

</Project>
