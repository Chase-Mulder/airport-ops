<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Airport Ops</title>
    <link rel="stylesheet" href="_content/Airport.UI/css/airport.css" />
    <HeadOutlet @rendermode="InteractiveNoPrerender" />
</head>
<body>
    <Routes @rendermode="InteractiveNoPrerender" />
    <div id="blazor-error-ui">
        Something went wrong. <a href="" class="reload">Reload</a>
    </div>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // The simulation is live state; prerendering would just render it twice.
    private static readonly IComponentRenderMode InteractiveNoPrerender = new InteractiveServerRenderMode(prerender: false);
}
