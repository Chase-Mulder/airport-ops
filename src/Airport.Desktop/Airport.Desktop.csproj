<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Desktop build: a local Blazor Server app with SQL persistence.
    Publishing produces AirportOps.exe, which starts a local web server and opens the browser.
      dotnet publish src/Airport.Desktop -c Release -r win-x64 -self-contained -o publish/AirportOps
  -->
  <PropertyGroup>
    <AssemblyName>AirportOps</AssemblyName>
    <RootNamespace>Airport.Desktop</RootNamespace>
    <Description>Airport Operations Center (desktop edition)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Airport.UI\Airport.UI.csproj" />
    <ProjectReference Include="..\Airport.Data\Airport.Data.csproj" />
  </ItemGroup>

</Project>
